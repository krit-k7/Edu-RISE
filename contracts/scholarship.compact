pragma language_version >= 0.22;

import CompactStandardLibrary;

// -----------------------------------------------------------------------------
// Ledger State (Public, on-chain)
// -----------------------------------------------------------------------------
export ledger min_gpa: Uint<32>;
export ledger max_income: Uint<32>;
export ledger verified_count: Uint<32>; // Running counter of successful verifications
export ledger nullifiers: Set<Bytes<32>>; // Prevent double claims

// -----------------------------------------------------------------------------
// Constructor
// -----------------------------------------------------------------------------
constructor(initial_min_gpa: Uint<32>, initial_max_income: Uint<32>) {
    min_gpa = disclose(initial_min_gpa);
    max_income = disclose(initial_max_income);
    verified_count = disclose(0);
}

// -----------------------------------------------------------------------------
// Core Circuit (ZK proof)
// -----------------------------------------------------------------------------

// Verifies eligibility based on private credentials without revealing them.
// gpa, income and student_id are ordinary circuit arguments -- Compact keeps
// them private inside the proof by default (nothing here is disclosed except
// the nullifier and the pass/fail outcome), so the caller never has to
// upload a document or reveal their real numbers on-chain.
export circuit verify_eligibility(gpa: Uint<32>, income: Uint<32>, student_id: Bytes<32>): [] {
    assert(gpa > 0, "GPA must be greater than 0");
    assert(income > 0, "Income must be greater than 0");
    assert(gpa >= min_gpa, "GPA too low");
    assert(income <= max_income, "Income too high");

    // Generate a nullifier to prevent double-claiming.
    const nul = makeNullifier(student_id);
    assert(!nullifiers.member(disclose(nul)), "already verified");

    // Record the nullifier publicly and increment the counter.
    nullifiers.insert(disclose(nul));
    verified_count = disclose((verified_count + 1) as Uint<32>);
}

// -----------------------------------------------------------------------------
// Helper Circuit
// -----------------------------------------------------------------------------

// Derives an anonymous nullifier from a student ID.
export pure circuit makeNullifier(student_id: Bytes<32>): Bytes<32> {
    return persistentHash<Vector<2, Bytes<32>>>([pad(32, "scholarship:nullifier:v1"), student_id]);
}
