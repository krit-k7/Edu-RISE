pragma language_version >=0.22.0;

import CompactStandardLibrary;

// ============================================================
// Scholarship Eligibility Contract
//
// Publishes the scholarship's eligibility criteria on-chain and lets
// an applicant privately prove they meet them. The applicant's GPA
// and income never appear on the ledger or in any transaction — only
// the pass/fail result of the check is provable.
//
// DECISION (review item 7): repeated verification by the *same*
// applicant is not allowed. Without an issuer-signed identity
// credential (see PROJECT_SPEC.md's "known limitation" note on
// issuer credentials, review item 8) this contract cannot prevent a
// person from generating a brand-new applicant secret and re-applying
// under a fresh identity — that requires Sybil resistance an
// unauthenticated ZK circuit alone cannot provide. What it *can*
// guarantee is that the same locally-persisted applicant secret
// (see frontend/src/lib/applicantSecret.ts) cannot be used twice,
// which stops the accidental/naive case of a single applicant
// double-submitting from the same browser/device.
// ============================================================

// Public criteria, fixed at deployment. sealed tells the compiler
// to enforce that no exported circuit can ever change these after
// the constructor runs — instead of relying on the convention that
// "nothing happens to touch them."
export sealed ledger min_gpa: Uint<32>;
export sealed ledger max_income: Uint<32>;

// How many applicants have passed so far. This is aggregate public
// information only — it reveals nothing about any individual
// applicant's GPA or income.
export ledger verified_count: Counter;

// Nullifier set. Compact has no native Set type, so a nullifier set
// is conventionally a Map<Bytes<32>, Boolean> — presence of the key
// is all that matters, the Boolean value is unused/ignored.
export ledger used_nullifiers: Map<Bytes<32>, Boolean>;

// Domain separator for persistentCommit — scopes this contract's
// nullifiers to this circuit so the same secret can't accidentally
// collide with a nullifier meant for a different contract/circuit.
const NULLIFIER_DOMAIN: Bytes<32> = pad(32, "edurise:verify_eligibility:v1");

constructor(initial_min_gpa: Uint<32>, initial_max_income: Uint<32>) {
    min_gpa = disclose(initial_min_gpa);
    max_income = disclose(initial_max_income);
}

// Verifies an applicant's eligibility. gpa and income are private
// circuit inputs — they're never disclosed or written to the ledger,
// only the truth of these two assertions becomes part of the proof.
//
// applicant_secret is a private, per-applicant value the frontend
// generates once and persists locally (never sent anywhere, never
// disclosed). Its persistentCommit hash — not the secret itself —
// is what's checked against and inserted into used_nullifiers, so
// the ledger never learns which applicant this was, only that *some*
// as-yet-unseen applicant used this exact eligibility circuit.
export circuit verify_eligibility(
    gpa: Uint<32>,
    income: Uint<32>,
    applicant_secret: Bytes<32>,
): [] {
    assert(gpa >= min_gpa, "GPA too low");
    assert(income <= max_income, "Income too high");

    const nullifier = persistentCommit<Bytes<32>>(applicant_secret, NULLIFIER_DOMAIN);
    assert(!used_nullifiers.member(disclose(nullifier)), "Applicant has already verified eligibility");
    used_nullifiers.insert(disclose(nullifier), true);

    verified_count.increment(1);
}
